<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Hospital Logo -->
        <ImageView
            android:id="@+id/ivHospitalLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="32dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/logo"
            android:contentDescription="@string/_40s_hospital_logo"
            android:scaleType="fitCenter" />

        <!-- Hospital Name -->
        <TextView
            android:id="@+id/tvHospitalName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/_40s_hospital"
            android:textColor="#1565C0"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/your_health_our_priority"
            android:textColor="#607080"
            android:textSize="16sp" />

        <!-- Login Heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/patient_login"
            android:textColor="#183B56"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Email Address -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:hint="@string/email_address"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            android:padding="14dp"
            android:singleLine="true" />

        <!-- Password -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/password"
            android:inputType="textPassword"
            android:autofillHints="password"
            android:padding="14dp"
            android:singleLine="true" />

        <!-- Sign In Button -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/sign_in" />

        <!-- Create Account Link -->
        <TextView
            android:id="@+id/tvCreateAccount"
            android:layout_width="wrap_content"
            android:layout_height="51dp"
            android:layout_marginTop="24dp"
            android:padding="8dp"
            android:text="@string/don_t_have_an_account_create_account"
            android:textColor="#1565C0"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</ScrollView>
